# -----------------------------------------------------------------------------
# sdkconfig.defaults — Mini Lele
# Observação: com framework = arduino (libs pré-compiladas), muitos destes
# defaults podem ser ignorados; o pioarduino os aplica quando reconstrói o IDF.
# Mantidos aqui para documentar a intenção e valer quando forem aplicados.
# -----------------------------------------------------------------------------

# PSRAM Octal (ESP32-S3R8 — OPI 8 MB @ 80 MHz)
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Alocações pequenas ficam na RAM interna; grandes (buffers LVGL) vão p/ PSRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Watchdog de tarefa — 30 s (o firmware reconfigura para 20 s em runtime).
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# Gerência de energia: DESLIGADA no nível do IDF, pois o firmware faz o próprio
# escalonamento de clock (PwnPower::setPerformanceMode) e sono (PwnSleep).
# Deixar o DFS do IDF ligado brigaria com setCpuFrequencyMhz() e pode
# desestabilizar o Wi-Fi.
CONFIG_PM_ENABLE=n
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n

# Bluetooth LE HABILITADO (usado pelo módulo PwnBLE / scanner BLE).
# BLE apenas (sem Bluetooth Classic) para economizar RAM.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=n

# Pthreads
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096
